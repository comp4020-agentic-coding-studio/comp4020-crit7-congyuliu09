---
import { listRooms } from "../lib/db";
import "../styles.css";

const rooms = listRooms();
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ANU RoomFlow — Book a room</title>
  </head>
  <body>
    <header class="site-header">
      <p class="eyebrow">ANU RoomFlow</p>
      <h1>Book a study space</h1>
      <p class="subtitle">A simpler way to find and book study spaces at ANU.</p>
    </header>
    <nav aria-label="site">
      <a href="/" aria-current="page">Book a room</a>
      <a href="/bookings/">My bookings</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h2>Available rooms</h2>
      <ul class="room-list">
        {
          rooms.map((room) => (
            <li class="room-card">
              <p class="room-name">{room.roomName}</p>
              <p class="room-building">{room.building}</p>
              <p class="room-meta">
                {room.roomType} · seats {room.capacity}
              </p>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
